# Copiar para .env e ajustar. NUNCA pôr o .env no git.
AMBIENTE=desenvolvimento

# Ligação da aplicação (papel sem privilégios, sujeito a RLS)
DATABASE_URL=postgresql+psycopg://faturas_app:faturas_app@localhost:5432/faturas
# Ligação das migrações (dono das tabelas)
MIGRATIONS_DATABASE_URL=postgresql+psycopg://faturas:faturas@localhost:5432/faturas

# Armazenamento de documentos (MinIO local)
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=documentos
S3_ACCESS_KEY=faturas
S3_SECRET_KEY=faturas-minio

DOMINIO_EMAIL_ENTRADA=entrada.faturasemdia.local
SECRET_KEY=gerar-com-python-c-import-secrets-print-secrets-token-urlsafe-48
