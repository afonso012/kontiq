# Configuração de produção da Kontiq. Copie para deploy/.env e preencha.
# Nunca ponha este ficheiro no git (já está no .gitignore).

# Domínio já apontado (registo A) para o IP do servidor.
DOMINIO=kontiq.pt

# Gere cada uma com:  openssl rand -hex 32
SECRET_KEY=
DB_PASSWORD_DONO=
DB_PASSWORD_APP=

# Email (fornecedor SMTP: Brevo, Mailjet, Amazon SES, Zoho…). O domínio do remetente
# precisa dos registos SPF e DKIM que o fornecedor indicar.
SMTP_HOST=
SMTP_PORT=587
SMTP_UTILIZADOR=
SMTP_PASSWORD=
EMAIL_REMETENTE=Kontiq <nao-responder@kontiq.pt>

# SMS: "simulado" não envia nada (os clientes do portal entram com código por email).
SMS_MODO=simulado

# Pagamentos: "desligado" até haver fornecedor (o modo simulado é recusado em produção).
PAGAMENTOS_MODO=desligado

# Leitura de faturas sem QR: "teste" (sem custos) ou "anthropic" (precisa de chave).
IA_MODO=teste
ANTHROPIC_API_KEY=

# Erros no Sentry (opcional, plano gratuito chega no início).
SENTRY_DSN=

# Processos da aplicação (2 chega para um servidor de 2 vCPU).
WORKERS=2
